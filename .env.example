# Copy this file to .env locally, then replace every placeholder.
# Never commit .env or paste its values into issue trackers, chat, or logs.

# Telegram token from @BotFather. Use a separate token for development.
TELEGRAM_BOT_TOKEN=<replace-with-telegram-bot-token>

# Redis URL used by game state storage and BullMQ.
# Local development:
REDIS_URL=redis://localhost:6379
# Production should use a managed/private Redis endpoint and preferably TLS:
# REDIS_URL=rediss://<username>:<password>@<private-host>:<port>/<db>

# Allowed: error | warn | info | http | verbose | debug | silly
LOG_LEVEL=info

# Allowed: development | test | production
NODE_ENV=development

# Local bot HTTP port.
# On Render omit BOT_PORT; the service will use Render's injected PORT.
BOT_PORT=3001

# Allowed: true | false
MUTE_DEAD_PLAYERS=true
